# DHAP GBP AI check: API keys and models. ai_api_runner.py reads this file.
# Never paste keys into chat. Keep this file private: chmod 600 keys.env
# Put each key right after its = sign, with no spaces or quotes.

# ---- API keys ----
OPENAI_API_KEY=
GEMINI_API_KEY=
SERPAPI_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=

# ---- Models: the cheaper ones, always (only the top 2 names in each answer count) ----
DHAP_OPENAI_MODEL=gpt-5.4-mini
DHAP_GEMINI_MODEL=gemini-3.8-flash
DHAP_CLAUDE_MODEL=claude-sonnet-5-5
# Google AI (SerpApi) and Brave have no model choice. The top 2 names are pulled by claude-haiku-5-5.
