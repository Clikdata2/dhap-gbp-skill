# Copy to keys.env (same folder), fill in, then: chmod 600 keys.env
# Never paste keys into chat. ai_api_runner.py reads this file.
OPENAI_API_KEY=
GEMINI_API_KEY=
SERPAPI_API_KEY=
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
